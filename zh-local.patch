diff --git a/facefusion/translator.py b/facefusion/translator.py
index 9f5fb4f..b929d41 100644
--- a/facefusion/translator.py
+++ b/facefusion/translator.py
@@ -1,10 +1,11 @@
 import importlib
-from typing import Optional
+import re
+from typing import Any, Dict, List, Optional, Tuple
 
 from facefusion.types import Language, LocalePoolSet, Locales
 
 LOCALE_POOL_SET : LocalePoolSet = {}
-CURRENT_LANGUAGE : Language = 'en'
+CURRENT_LANGUAGE : Language = 'zh'
 
 
 def __autoload__(module_name : str) -> None:
@@ -33,3 +34,29 @@ def get(notation : str, module_name : str = 'facefusion') -> Optional[str]:
 				return current
 
 	return None
+
+
+def localize_choices(values : List[Any], overrides : Optional[Dict[str, str]] = None) -> List[Tuple[str, Any]]:
+	if CURRENT_LANGUAGE == 'en':
+		return [ (str(value), value) for value in values ]
+
+	if 'facefusion' not in LOCALE_POOL_SET:
+		__autoload__('facefusion')
+
+	choices = LOCALE_POOL_SET.get('facefusion', {}).get(CURRENT_LANGUAGE, {}).get('choices') or {}
+	if overrides:
+		choices = { **choices, **overrides }
+
+	result : List[Tuple[str, Any]] = []
+	for value in values:
+		key = str(value)
+		label = choices.get(key)
+
+		if label is None and '/' in key:
+			base_name = key.rsplit('/', 1)[-1]
+			base_name = re.sub(r'_\d+$', '', base_name)
+			label = choices.get(base_name)
+
+		result.append((label if label else key, value))
+
+	return result
